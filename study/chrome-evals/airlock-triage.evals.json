  {
    "name": "Status page: investigating",
    "messages": [
      { "role": "user", "type": "message", "content": "Post on the public status page that we are investigating errors on checkout." }
    ],
    "expectedCall": [
      { "functionName": "propose_status_update", "arguments": { "state": "investigating", "text": { "$contains": "checkout" } } }
    ]
  },
  {
    "name": "Record a finding with advice against the trap",
    "messages": [
      { "role": "user", "type": "message", "content": "Write your read of the incident into the console: checkout 500s started after deploy d-201, whose migration mig-77 dropped legacy_cart. Advise against rolling back d-201 because the old build cannot read the migrated rows." }
    ],
    "expectedCall": [
      { "functionName": "list_deploys", "arguments": {}, "optional": true },
      { "functionName": "read_logs", "arguments": {}, "optional": true },
      { "functionName": "record_finding", "arguments": { "summary": { "$contains": "d-201" }, "advisesAgainst": { "$contains": "d-201" } } }
    ]
  },
  {
    "name": "Ordered incident-command plan",
    "messages": [
      { "role": "user", "type": "message", "content": "Plan the incident response in this order and say why the order matters: first acknowledge it as agent-oncall, then declare sev1, then post an 'investigating' status-page update about checkout." }
    ],
    "expectedCall": [
      {
        "functionName": "propose_plan",
        "arguments": {
          "reason": { "$type": "string" },
          "steps": [
            { "tool": "propose_acknowledge", "input": { "by": { "$contains": "agent" } } },
            { "tool": "propose_severity", "input": { "level": "sev1" } },
            { "tool": "propose_status_update", "input": { "state": "investigating", "text": { "$contains": "checkout" } } }
          ]
        }
      }
    ]
  }
