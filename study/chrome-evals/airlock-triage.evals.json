  },
  {
    "name": "Declare severity",
    "messages": [
      { "role": "user", "type": "message", "content": "Declare this a sev1." }
    ],
    "expectedCall": [
      { "functionName": "propose_severity", "arguments": { "level": "sev1" } }
    ]
  },
  {
    "name": "Escalate to the database on-call",
    "messages": [
      { "role": "user", "type": "message", "content": "Page the database on-call." }
    ],
    "expectedCall": [
      { "functionName": "propose_escalate", "arguments": { "team": { "$contains": "database" } } }
    ]
  },
  {
    "name": "Silence alerts",
    "messages": [
      { "role": "user", "type": "message", "content": "Silence alerting while we work this." }
    ],
    "expectedCall": [
      { "functionName": "propose_silence_alerts", "arguments": { "silenced": true } }
